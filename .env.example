SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/pulse_db?useSSL=false&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=change-me
SPRING_DATASOURCE_DRIVER_CLASS_NAME=com.mysql.cj.jdbc.Driver
SPRING_JPA_DDL_AUTO=update
SPRING_JPA_SHOW_SQL=true
JWT_SECRET=replace-with-a-32-byte-secret
JWT_EXPIRATION=86400000
FASTAPI_BASE_URL=http://127.0.0.1:8000/api
SERVER_PORT=8080
# 날씨(대시보드 insights.weather) — 재난안전데이터공유플랫폼 단기예보(SKY/PTY)
# 데이터셋별 활용신청 후 승인된 단기예보 API ID를 WEATHER_API_ID에 입력
WEATHER_BASE_URL=https://www.safetydata.go.kr/V2/api
WEATHER_API_ID=replace-with-approved-short-term-forecast-dataset-id
WEATHER_API_KEY=replace-with-your-safetydata-service-key
